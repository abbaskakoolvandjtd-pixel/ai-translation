# Translation Service Configuration

# File upload settings
MAX_UPLOAD_SIZE_MB=100

# Local storage paths (adjust these to your environment)
LOCAL_SHARE_FILE_PATH=/workspace/shared
LOCAL_SPMBI_PATH=/workspace/spmbi
LOCAL_UPLOAD_PATH=/workspace/uploads

# Database configuration (example - adjust as needed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=translation_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret Key (change this in production!)
JWT_SECRET_KEY=your-secret-key-change-in-production

# API Keys (replace with actual keys)
GOOGLE_API_KEY=your_google_api_key
DEEPL_API_KEY=your_deepl_api_key
